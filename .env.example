# Secrets only. Non-secret settings live in mediarotator/.rotator_config.json.

# Radarr / Sonarr
RADARR_API_KEY=your_radarr_api_key_here
SONARR_API_KEY=your_sonarr_api_key_here

# qBittorrent
# Only needed if you want shelf deletions to remove the remote torrent gracefully.
QBITTORRENT_URL=http://qbittorrent:8080
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=adminadmin
SEEDBOX_DELETE_ENABLED=true

# Trakt (optional)
TRAKT_CLIENT_ID=your_trakt_client_id_here
